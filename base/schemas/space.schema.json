{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hyper-dimension:space:v1",
  "title": "Hyper Dimension Base space package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "baseVersion",
    "spaceId",
    "name",
    "scenes",
    "spawn",
    "knowledge",
    "agents"
  ],
  "properties": {
    "protocol": {
      "const": "hyper-dimension.base/v1"
    },
    "baseVersion": {
      "enum": ["0.1.0", "0.1.1", "0.2.0", "0.2.1"]
    },
    "spaceId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$",
      "not": {
        "enum": ["constructor", "prototype", "__proto__"]
      }
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "description": {
      "type": "string"
    },
    "theme": {
      "type": "object"
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "scene.schema.json"
      }
    },
    "spawn": {
      "type": "object",
      "required": ["sceneId", "levelId", "point"],
      "properties": {
        "sceneId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$",
          "not": {
            "enum": ["constructor", "prototype", "__proto__"]
          }
        },
        "levelId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$",
          "not": {
            "enum": ["constructor", "prototype", "__proto__"]
          }
        },
        "point": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        }
      }
    },
    "knowledge": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "body", "published"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$",
            "not": {
              "enum": ["constructor", "prototype", "__proto__"]
            }
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "published": {
            "type": "boolean"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sceneId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$",
            "not": {
              "enum": ["constructor", "prototype", "__proto__"]
            }
          },
          "entityId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$",
            "not": {
              "enum": ["constructor", "prototype", "__proto__"]
            }
          }
        }
      }
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["agentId", "name", "skills"],
        "properties": {
          "agentId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$",
            "not": {
              "enum": ["constructor", "prototype", "__proto__"]
            }
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "skills": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$",
              "not": {
                "enum": ["constructor", "prototype", "__proto__"]
              }
            }
          }
        }
      }
    },
    "source": {
      "type": "object"
    },
    "contacts": {
      "type": "object"
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "file", "published"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$",
            "not": {
              "enum": ["constructor", "prototype", "__proto__"]
            }
          },
          "file": {
            "type": "string",
            "pattern": "^assets/(?:[a-zA-Z0-9_-]+/)*[a-zA-Z0-9_-]+\\.(png|jpg|webp|glb)$"
          },
          "published": {
            "type": "boolean"
          }
        }
      }
    },
    "exhibits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "entityId", "title", "body", "assetIds", "published"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$",
            "not": {
              "enum": ["constructor", "prototype", "__proto__"]
            }
          },
          "entityId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$",
            "not": {
              "enum": ["constructor", "prototype", "__proto__"]
            }
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "assetIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$",
              "not": {
                "enum": ["constructor", "prototype", "__proto__"]
              }
            }
          },
          "published": {
            "type": "boolean"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
